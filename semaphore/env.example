# Copy to .env next to podman-compose.yml and change every "changeme"

# MySQL (semaphore_db)
MYSQL_USER=semaphore
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=semaphore
MYSQL_RANDOM_ROOT_PASSWORD=yes

# Semaphore → MySQL (must match the above)
SEMAPHORE_DB_DIALECT=mysql
SEMAPHORE_DB_HOST=semaphore_db
SEMAPHORE_DB_NAME=semaphore
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=changeme

# First admin account
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=changeme
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@example.com

SEMAPHORE_SCHEDULE_TIMEZONE=Europe/Berlin
SEMAPHORE_TOTP_ENABLED=false
SEMAPHORE_TOTP_ALLOW_RECOVERY=false
SEMAPHORE_AUTO_MIGRATE=true
ANSIBLE_HOST_KEY_CHECKING=false

# Optional Telegram alerts
SEMAPHORE_TELEGRAM_ALERT=false
SEMAPHORE_TELEGRAM_CHAT=
SEMAPHORE_TELEGRAM_TOKEN=
